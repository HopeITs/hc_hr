APP_NAME=HopeHR
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Contract pay figures are encrypted at rest under this key, NOT under APP_KEY,
# so a database copy taken together with a developer .env still cannot read
# them. Generate with `php artisan salary:key:generate`, set it on the
# production server only, and back it up somewhere other than the database --
# losing it loses every salary. Verify a host with `php artisan salary:key:check`.
# Left blank, the application falls back to APP_KEY, which is fine for a local
# database and is reported as a misconfiguration in production.
SALARY_ENCRYPTION_KEY=
# X2-I anonymous task-attempt telemetry (DEC-10). Off by default: turning it on
# in production is a separate, authorized decision. See config/telemetry.php.
TASK_TELEMETRY_ENABLED=false
APP_URL=http://hope-hr.test
LOCAL_SEED_PASSWORD=

# Browser security headers. HSTS defaults on in staging/production and off
# locally. Keep CSP report-only until violations have been reviewed.
SECURITY_HEADERS_HSTS=false
CSP_REPORT_ONLY=true

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_AE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hr_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
OFFICE_PREVIEW_CONVERSION_ENABLED=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Never commit real credentials here. This file is tracked in Git; put actual
# values only in .env (untracked) or the deployment secret manager.
MAIL_MAILER=smtp
MAIL_HOST=mail.s1893.sureserver.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@hcsyria-apps.org
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="no-reply@hcsyria-apps.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_DRIVE_API_KEY=

# Contract PDF export (Spatie Browsershot).
# On a Linux server use the distribution's own Chromium — the package manager
# installs the libraries and system integration it needs alongside it.
BROWSERSHOT_CHROME_PATH=/usr/bin/chromium
# Only needed when node is not on the web user's PATH.
BROWSERSHOT_NODE_BINARY=
BROWSERSHOT_TIMEOUT=120

# Recruitment uploads: ClamAV antivirus (apt install clamav clamav-daemon).
# "disabled" keeps every upload in quarantine (undownloadable); it never skips the scan.
RECRUITMENT_SCANNER=clamd
CLAMD_SOCKET=/var/run/clamav/clamd.ctl
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_TIMEOUT=30

# CV analysis, all local and free (apt install poppler-utils tesseract-ocr tesseract-ocr-ara antiword).
RECRUITMENT_CV_ANALYSIS=true
RECRUITMENT_CV_OCR=true
PDFTOTEXT_BINARY=pdftotext
PDFTOPPM_BINARY=pdftoppm
TESSERACT_BINARY=tesseract
ANTIWORD_BINARY=antiword
# Optional remote Chrome, e.g. wss://<browserless-host>?token=<token>. Empty =
# local Chrome. Setting it sends contracts (with pay) to that service.
BROWSERSHOT_WS_ENDPOINT=
